# 留空时运行本地演示；配置后启用真实模型。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# 本地默认无需登录。设置后所有业务 API 均要求 Bearer token。
APP_ACCESS_TOKEN=
# 默认示例数据库；可改为 MySQL 或 PostgreSQL 的只读账号。
# DATABASE_URL=mysql+aiomysql://chatdb_reader:password@127.0.0.1:3306/business
# DATABASE_URL=postgresql+asyncpg://chatdb_reader:password@localhost:5432/business
DATABASE_URL=
DATABASE_SCHEMAS=public
QUERY_TIMEOUT_SECONDS=10
QUERY_ROW_LIMIT=200
# 应用会话、审计和知识库的持久化路径。
APP_DATA_DIR=./data
